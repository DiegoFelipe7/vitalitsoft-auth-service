# ============================================
# VitalitSoft Auth Service - Environment Variables
# ============================================

# Server Configuration
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# R2DBC / PostgreSQL Configuration
R2DBC_HOST=db
R2DBC_PORT=5432
R2DBC_DATABASE=postgres
R2DBC_SCHEMA=public
R2DBC_USERNAME=postgres
R2DBC_PASSWORD=your_postgres_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_min_256_bits
JWT_EXPIRATION=3600000
JWT_EXPIRATION_REFRESH_TOKEN=86400000
JWT_HEADER=Authorization
JWT_PREFIX=Bearer

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# RabbitMQ Configuration
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_USERNAME=vitalitsoft
RABBIT_PASSWORD=your_rabbit_password
RABBIT_VIRTUAL_HOST=/
RABBIT_CONNECTION_TIMEOUT=10000
RABBIT_EXCHANGES=vitalitsoft.auth.events,vitalitsoft.user.events
RABBIT_ROUTING_KEYS=user.created.v1,user.login.v1,password.reset.requested.v1
RABBIT_QUEUES=queue.auth.v1,queue.user.v1

# RabbitMQ Default User (for Docker container)
RABBITMQ_DEFAULT_USER=vitalitsoft
RABBITMQ_DEFAULT_PASS=your_rabbit_password
